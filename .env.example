# ============================================================
# Contoh konfigurasi - salin menjadi .env lalu isi nilainya
# ============================================================

# Database produksi (Neon). Untuk lokal pakai output `npx prisma dev`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
SHADOW_DATABASE_URL=""

# Kunci penandatanganan sesi (wajib)
AUTH_SECRET="jalankan: openssl rand -base64 32"
AUTH_TRUST_HOST="true"

# Google OAuth - biarkan kosong jika belum disiapkan.
# Selama kosong, tombol "Masuk dengan Google" otomatis disembunyikan
# dan login email+password tetap berfungsi penuh.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Alamat dasar aplikasi. Dipakai menyusun tautan di dalam surel pemulihan.
# Header Host dari permintaan sengaja tidak dipakai - ia dapat dipalsukan,
# dan tautan pemulihan yang menunjuk alamat lain adalah cara mencuri akun.
NEXTAUTH_URL="https://cv-ats-builder-henna.vercel.app"

# Pengiriman surel (Brevo) - biarkan kosong jika belum disiapkan.
# Selama kosong, halaman "Lupa kata sandi" menampilkan penjelasan jalan
# yang memang sudah ada (masuk lewat Google, lalu buat kata sandi di
# Pengaturan) alih-alih formulir yang tidak akan mengirim apa pun.
#
# Cara menyiapkannya tanpa punya domain sendiri:
#   1. Daftar gratis di brevo.com
#   2. Senders, Domains & Dedicated IPs > Senders > Add a Sender
#      Verifikasi satu alamat email biasa (Gmail pun bisa)
#   3. SMTP & API > API Keys > Generate a new API key
#   4. Isi kedua nilai di bawah, di lokal maupun di dashboard Vercel
BREVO_API_KEY=""
MAIL_FROM=""

# ============================================================
# Panel pengelola
# ============================================================
# Alamat surel yang boleh membuka /admin. Kosongkan bila tidak ada
# pengelola - selama kosong, rutenya membalas 404 bagi siapa pun.
#
# Harus sama persis dengan email akun yang sudah terdaftar di aplikasi
# (huruf besar-kecil diabaikan). Panel ini hanya melihat DATA AKUN;
# isi CV pengguna tidak pernah dapat dibuka dari sana.
ADMIN_EMAIL=""
