# ============================================================
# Contoh konfigurasi - salin menjadi .env lalu isi nilainya
# ============================================================

# Database produksi (Neon). Untuk lokal pakai output `npx prisma dev`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
SHADOW_DATABASE_URL=""

# Kunci penandatanganan sesi (wajib)
AUTH_SECRET="jalankan: openssl rand -base64 32"
AUTH_TRUST_HOST="true"

# Google OAuth - biarkan kosong jika belum disiapkan.
# Selama kosong, tombol "Masuk dengan Google" otomatis disembunyikan
# dan login email+password tetap berfungsi penuh.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
