// ============================================================================
//  ATS-Friendly CV Builder - Skema Basis Data
//  DBMS   : PostgreSQL (Neon)
//  ORM    : Prisma 7
//
//  Catatan desain:
//  - Semua tanggal CV disimpan sebagai String "YYYY-MM" (presisi bulan).
//    Alasan: CV hanya butuh bulan+tahun, cocok dengan <input type="month">,
//    dan bebas dari bug zona waktu yang muncul jika memakai DateTime.
//  - Kolom teks memakai default "" (bukan NULL) agar penanganan form
//    di frontend konsisten dan tidak perlu null-check di mana-mana.
//  - Seluruh tabel anak memakai onDelete: Cascade dari Resume.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUM
// ----------------------------------------------------------------------------

/// Seluruh template bertata letak satu kolom. Yang membedakan hanya
/// tipografi, jarak, garis, dan penempatan foto - bukan struktur bacaannya.
/// Alasannya ada di komentar berkas ResumeDocument.tsx: tata letak dua kolom
/// membuat pengurai ATS membaca teks berselang-seling antar-kolom.
enum TemplateId {
  CLASSIC
  MODERN
  COMPACT
  EXECUTIVE
  MINIMAL
  TIMELINE
  ACADEMIC
  GOVERNMENT
  PORTRAIT
  PROFILE
}

/// Ukuran kertas. A4 adalah bawaan sekaligus yang disarankan karena dipakai
/// hampir seluruh dunia kecuali Amerika Utara; Letter disediakan untuk
/// lamaran ke perusahaan Amerika, Legal dan F4 untuk instansi yang masih
/// memintanya.
enum PaperSize {
  A4
  LETTER
  LEGAL
  F4
}

enum ResumeLanguage {
  ID
  EN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  VOLUNTEER
}

enum LanguageProficiency {
  NATIVE
  FLUENT
  ADVANCED
  INTERMEDIATE
  BASIC
}

// ----------------------------------------------------------------------------
// AUTENTIKASI
// ----------------------------------------------------------------------------

/// Pengguna aplikasi. passwordHash bernilai NULL apabila pengguna
/// mendaftar lewat Google OAuth (tidak pernah menetapkan kata sandi).
model User {
  id            String    @id @default(cuid())
  name          String    @default("")
  email         String    @unique
  emailVerified DateTime?
  image         String    @default("")
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  resumes     Resume[]
  resetTokens PasswordResetToken[]

  @@map("users")
}

/// Tautan akun penyedia OAuth (Google) ke User lokal.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ----------------------------------------------------------------------------
// DOKUMEN CV
// ----------------------------------------------------------------------------

/// Satu dokumen CV. Seorang pengguna boleh memiliki banyak versi CV
/// (misalnya versi "Frontend Developer" dan versi "Product Manager").
model Resume {
  id          String         @id @default(cuid())
  userId      String
  title       String         @default("CV Saya")
  template    TemplateId     @default(CLASSIC)
  accentColor String         @default("#111827")
  fontFamily  String         @default("Arial")
  fontSize    Int            @default(10)
  lineHeight  Float          @default(1.35)
  language    ResumeLanguage @default(ID)
  pageSize    PaperSize      @default(A4)

  /// Margin halaman dalam milimeter, bila pengguna menyetelnya sendiri.
  /// NULL berarti "ikut template" - disimpan sebagai NULL, bukan disalin
  /// angkanya, supaya CV yang belum pernah disetel manual ikut menyesuaikan
  /// sendiri ketika templatenya diganti.
  marginYMm   Int?
  marginXMm   Int?

  /// Urutan tampil section pada CV, contoh:
  /// ["summary","experience","education","skill","project"]
  sectionOrder Json

  /// Versi bentuk data dokumen ini. 1 = sebelum portofolio berbasis pola.
  /// Baris lama tetap bernilai 1 sampai dibaca dan disimpan ulang, dan
  /// menaikkannya tidak mengubah satu pun isian penggunanya.
  schemaVersion Int @default(1)

  /// Pola pembuktian, tujuan CV, dan jenjang pengalaman pemiliknya.
  /// NULL berarti pengguna belum pernah menjawab pertanyaan pembuka - dan
  /// selama itu, bentuk formulirnya sama persis seperti sebelum fitur ini ada.
  profilPortofolio Json?

  /// Pengaturan bagian portofolio (aktif, judul, gabung ke pengalaman,
  /// mode redaksi). Daftar itemnya sendiri ada di tabel projects, karena
  /// bagian itu yang diperluas - bukan bagian baru di sebelahnya.
  portofolio Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalInfo   PersonalInfo?
  experiences    Experience[]
  educations     Education[]
  skills         Skill[]
  projects       Project[]
  certifications Certification[]
  organizations  Organization[]
  awards         Award[]
  languages      LanguageSkill[]
  publications   Publication[]
  customSections CustomSection[]
  atsAnalyses    AtsAnalysis[]

  @@index([userId])
  @@map("resumes")
}

/// Identitas dan kontak. Relasi satu-ke-satu dengan Resume.
model PersonalInfo {
  id           String  @id @default(cuid())
  resumeId     String  @unique
  fullName     String  @default("")
  headline     String  @default("")
  email        String  @default("")
  phone        String  @default("")
  city         String  @default("")
  province     String  @default("")
  country      String  @default("")
  linkedinUrl  String  @default("")
  portfolioUrl String  @default("")
  githubUrl    String  @default("")
  photoUrl     String  @default("")
  showPhoto    Boolean @default(false)
  /// Perbesaran dan geseran pas foto di dalam bingkainya. Yang disimpan
  /// parameternya, bukan gambar hasil potongan - lihat PersonalInfo di
  /// src/lib/resume/types.ts untuk alasannya.
  photoZoom    Float   @default(1)
  photoOffsetX Float   @default(0)
  photoOffsetY Float   @default(0)
  /// Lebar pas foto dalam milimeter. NULL berarti mengikuti bawaan template.
  photoWidthMm Float?
  summary      String  @default("")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("personal_infos")
}

model Experience {
  id             String          @id @default(cuid())
  resumeId       String
  jobTitle       String          @default("")
  company        String          @default("")
  employmentType EmploymentType?
  city           String          @default("")
  country        String          @default("")
  startDate      String          @default("")
  endDate        String          @default("")
  isCurrent      Boolean         @default(false)
  bullets        String[]        @default([])
  order          Int             @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("experiences")
}

model Education {
  id           String   @id @default(cuid())
  resumeId     String
  institution  String   @default("")
  degree       String   @default("")
  fieldOfStudy String   @default("")
  city         String   @default("")
  startDate    String   @default("")
  endDate      String   @default("")
  isCurrent    Boolean  @default(false)
  gpa          String   @default("")
  maxGpa       String   @default("4.00")
  bullets      String[] @default([])
  order        Int      @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("educations")
}

/// Keahlian dikelompokkan per kategori (mis. "Bahasa Pemrograman", "Tools").
model Skill {
  id       String @id @default(cuid())
  resumeId String
  name     String @default("")
  category String @default("Umum")
  order    Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("skills")
}

/// Satu item portofolio.
///
/// Namanya masih Project karena memang bagian inilah yang diperluas: bentuknya
/// sejak awal sudah nyaris sama dengan "field umum" portofolio, sehingga
/// membuat tabel kedua hanya akan memecah data yang seharusnya satu.
model Project {
  id        String   @id @default(cuid())
  resumeId  String
  name      String   @default("")
  role      String   @default("")
  url       String   @default("")
  startDate String   @default("")
  endDate   String   @default("")
  bullets   String[] @default([])
  order     Int      @default(0)

  /// Klien, institusi, kampus, "Proyek Mandiri", atau "Freelance".
  konteks   String   @default("")
  lokasi    String   @default("")
  ringkasan String   @default("")
  refleksi  String   @default("")
  /// "" berarti item ini mengikuti pola CV-nya.
  polaOverride String @default("")
  /// Id entri pengalaman kerja yang menjadi induk saat item digabungkan ke
  /// PENGALAMAN KERJA. "" berarti item berdiri sendiri. Sengaja bukan relasi
  /// berkunci asing: baris anak ditulis ulang seluruhnya setiap penyimpanan,
  /// dan kunci asing akan menolak urutan penulisannya.
  parentPengalamanId String @default("")
  kataKunci String[] @default([])
  /// Daftar tautan: [{ label, url }], maksimal dua.
  tautan    Json     @default("[]")
  /// Field inti pola, dikunci nama field dari pola-schemas.ts.
  inti      Json     @default("{}")
  /// Slot fleksibel: [{ label, nilai, satuan, prioritas }], maksimal enam.
  detailTambahan Json @default("[]")
  /// Nama, jabatan, dan hubungan orang yang dapat memastikan kebenaran item.
  ///
  /// DATA PRIBADI MILIK PIHAK KETIGA. Tidak pernah dicetak di CV dan tidak
  /// pernah ikut ke berkas ekspor mana pun. Ikut terhapus bersama akun lewat
  /// ON DELETE CASCADE dari resumes, dan itulah kenapa ia disimpan di sini -
  /// bukan di tabel yang berumur lebih panjang daripada CV-nya.
  verifikator Json   @default("{}")
  /// Isian dari pola sebelumnya, disimpan agar dapat dipulihkan.
  arsip     Json     @default("{}")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("projects")
}

model Certification {
  id           String @id @default(cuid())
  resumeId     String
  name         String @default("")
  issuer       String @default("")
  issueDate    String @default("")
  expiryDate   String @default("")
  credentialId String @default("")
  url          String @default("")
  order        Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("certifications")
}

model Organization {
  id        String   @id @default(cuid())
  resumeId  String
  name      String   @default("")
  role      String   @default("")
  city      String   @default("")
  startDate String   @default("")
  endDate   String   @default("")
  isCurrent Boolean  @default(false)
  bullets   String[] @default([])
  order     Int      @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("organizations")
}

model Award {
  id          String @id @default(cuid())
  resumeId    String
  title       String @default("")
  issuer      String @default("")
  date        String @default("")
  description String @default("")
  order       Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("awards")
}

model LanguageSkill {
  id          String              @id @default(cuid())
  resumeId    String
  name        String              @default("")
  proficiency LanguageProficiency @default(INTERMEDIATE)
  order       Int                 @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("language_skills")
}

/// Satu karya terbit.
///
/// Bentuknya memang sudah pola "Publikasi & Kredit" dalam wujud sederhana,
/// jadi ia diperluas: title menampung sitasi lengkap, publisher menampung
/// venue, url dan doi menampung pengenal persisten.
model Publication {
  id        String @id @default(cuid())
  resumeId  String
  title     String @default("")
  publisher String @default("")
  date      String @default("")
  url       String @default("")
  doi       String @default("")
  order     Int    @default(0)

  /// Artikel jurnal, prosiding, paten, pertunjukan, pameran, dan seterusnya.
  tipeLuaran    String @default("")
  /// Penulis pertama, korespondensi, anggota, pemain, sutradara, kurator.
  peranSaya     String @default("")
  /// Scopus Q1-Q4, SINTA 1-6, WoS, Garuda, festival internasional, lokal.
  indeksasiTier String @default("")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("publications")
}

/// Section bebas buatan pengguna. Kolom items berisi array objek
/// { title, subtitle, startDate, endDate, bullets[] }.
model CustomSection {
  id       String @id @default(cuid())
  resumeId String
  title    String @default("")
  items    Json   @default("[]")
  order    Int    @default(0)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("custom_sections")
}

// ----------------------------------------------------------------------------
// ANALISIS ATS
// ----------------------------------------------------------------------------

/// Riwayat hasil penilaian ATS. Disimpan (bukan sekadar dihitung sesaat)
/// agar peningkatan skor sebelum dan sesudah perbaikan dapat dianalisis
/// sebagai data penelitian.
model AtsAnalysis {
  id             String   @id @default(cuid())
  resumeId       String
  score          Int
  /// Skor per dimensi: completeness, parseability, contentQuality,
  /// keywordMatch, structure - beserta detail temuannya.
  breakdown      Json
  /// Daftar saran perbaikan yang dapat ditindaklanjuti pengguna.
  suggestions    Json
  jobDescription String   @default("")
  createdAt      DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@map("ats_analyses")
}

// ----------------------------------------------------------------------------
// PEMULIHAN KATA SANDI
// ----------------------------------------------------------------------------

/// Tiket sekali pakai untuk menyetel ulang kata sandi lewat tautan di surel.
///
/// Yang disimpan di sini **bukan** token yang dikirim ke pengguna, melainkan
/// hasil SHA-256 atasnya. Tabel ini karena itu tidak berguna bagi siapa pun
/// yang berhasil membacanya: dari hash tidak dapat disusun kembali tautan yang
/// dapat dipakai masuk. Perlakuan yang sama seperti kata sandi itu sendiri,
/// dan karena alasan yang sama - sebuah tiket reset yang bocor sama saja
/// dengan kata sandi yang bocor.
///
/// Tiket lama tidak dihapus saat dipakai melainkan ditandai `usedAt`, supaya
/// tautan yang sudah terpakai dapat dibedakan dari tautan yang tidak pernah
/// ada - keduanya ditolak, tetapi hanya yang pertama pantas diberi tahu
/// alasannya.
model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 dari token yang dikirim lewat surel, dalam heksadesimal.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------
// PEMBATASAN LAJU PERMINTAAN
// ----------------------------------------------------------------------------

/// Penghitung percobaan untuk membatasi laju permintaan sensitif
/// (pendaftaran dan masuk).
///
/// Disimpan di basis data, bukan di memori proses, karena aplikasi berjalan
/// pada lingkungan serverless: setiap permintaan dapat dilayani instans yang
/// berbeda, sehingga penghitung di memori mudah dilewati begitu saja.
model RateLimit {
  /// Kunci pembatas, mis. "login:budi@email.com" atau "register:203.0.113.5".
  key       String   @id
  count     Int      @default(0)
  /// Batas akhir jendela waktu berjalan.
  windowEnd DateTime

  @@index([windowEnd])
  @@map("rate_limits")
}
